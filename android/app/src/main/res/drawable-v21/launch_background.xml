<?xml version="1.0" encoding="utf-8"?>
<!-- What the window shows between the tap and Flutter's first frame.
     `?android:colorBackground` follows the system's dark/light setting, which
     is the closest match available here: the app's own theme lives in Dart and
     has not been read yet at this point. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="?android:colorBackground" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
