<?xml version="1.0" encoding="utf-8"?>
<!--
  Permits cleartext HTTP to the loopback address, and nowhere else.

  `LockCachingAudioSource` does not hand ExoPlayer a URL: it runs a small HTTP
  server on 127.0.0.1 and serves the bytes through that while writing them to
  the cache file. Android has blocked cleartext by default since API 28, so
  ExoPlayer refused to connect to just_audio's own proxy and every track failed
  with `CleartextNotPermittedException` before a byte of music was read.

  Scoped to 127.0.0.1 deliberately rather than setting `usesCleartextTraffic`
  on the whole application. Plex is reached over HTTPS via plex.direct and must
  stay that way: the token travels in the query string, so a blanket opt-in
  would put it on the wire in plaintext on any network that downgraded the
  connection.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
